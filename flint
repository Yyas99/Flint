#!/bin/bash
# Flint: builds Flint.app (AppKit window + WebKit, Safari's engine) and opens it.
#   ./flint          build if anything changed, then open
#   ./flint build    force a rebuild, then open
#   ./flint stop     quit Flint
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
LIVE="$DIR/Flint.app"; SRC="$DIR/Flint.m"; LOG="$DIR/build.log"
# Builds go to .staged/Flint.app. Flint, if it's open, shows an "Update" pill and swaps in when you click it;
# if Flint isn't open (or this is the first staged build), the new build is installed and opened right away.
STAGE="$DIR/.staged"; FIRST_STAGE=0; [ -d "$STAGE" ] || FIRST_STAGE=1; mkdir -p "$STAGE"
APP="$STAGE/Flint.app"; BIN="$APP/Contents/MacOS/Flint"
if [ "$1" = "stop" ]; then pkill -a -x Flint 2>/dev/null || true; echo "Flint stopped"; exit 0; fi

install_staged() {   # quit Flint, put the staged build in place, open it (tabs are restored)
  pkill -a -x Flint 2>/dev/null || true
  for i in $(seq 1 50); do pgrep -a -x Flint >/dev/null || break; sleep 0.1; done
  pkill -9 -a -x Flint 2>/dev/null || true
  rm -rf "$LIVE.old"; [ -d "$LIVE" ] && mv "$LIVE" "$LIVE.old"
  if ditto "$APP" "$LIVE"; then rm -rf "$LIVE.old"; else rm -rf "$LIVE"; mv "$LIVE.old" "$LIVE"; fi
  rm -f "$STAGE/ready" "$STAGE/install" "$STAGE/notes"; : > "$DIR/update-notes.txt"
  touch "$LIVE"
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$LIVE" >/dev/null 2>&1 || true
  open "$LIVE" || { sleep 1; open "$LIVE"; }
}

B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'; G=$'\033[38;5;114m'; E=$'\033[38;5;203m'; A=$'\033[38;5;173m'; CL=$'\r\033[K'
SPIN=(✻ ✼ ✽ ✾ ✿ ❀ ✿ ✾ ✽ ✼); K=0
fmt() { local s=$1; if [ "$s" -ge 60 ]; then printf '%dm%02ds' $((s/60)) $((s%60)); else printf '%ds' "$s"; fi; }
since() { fmt $(( $(date +%s) - $1 )); }
label() { printf '%-9s' "$1"; }
done_line() { printf '%s %s✓%s %s%s%s %s%s%s\n' "$CL" "$G" "$R" "$B" "$(label "$1")" "$R" "$D" "$2" "$R"; echo "✓ $1 $2" >> "$LOG"; }
fail_line() { printf '%s %s✗%s %s%s%s %s\n' "$CL" "$E" "$R" "$B" "$(label "$1")" "$R" "$2"; echo "✗ $1 $2" >> "$LOG"; }
COLS=$(tput cols 2>/dev/null || echo 80); BW=$(( COLS / 4 )); [ $BW -gt 28 ] && BW=28; [ $BW -lt 8 ] && BW=8
bar() { local p=$1 f i out=""; f=$(( p * BW / 100 )); for ((i=0;i<f;i++)); do out+="━"; done; out+="$R$D"; for ((i=f;i<BW;i++)); do out+="─"; done; printf '%s%s%s' "$A" "$out" "$R"; }
live() { printf '%s %s%s%s %s%s%s %s %s%3d%%%s  %s%s%s' "$CL" "$A" "${SPIN[$((K % 10))]}" "$R" "$B" "$(label "$1")" "$R" "$(bar "$2")" "$B" "$2" "$R" "$D" "$3" "$R"; }

if ! xcode-select -p >/dev/null 2>&1; then fail_line "Tools" "Command Line Tools missing — installing; run again after"; xcode-select --install || true; exit 1; fi
# one build at a time (Flint builds itself now; an old Terminal watcher may still be running)
LOCK="$DIR/.buildlock"
if ! mkdir "$LOCK" 2>/dev/null; then
  if [ $(( $(date +%s) - $(stat -f %m "$LOCK") )) -lt 300 ]; then exit 0; fi
  rm -rf "$LOCK"; mkdir "$LOCK"
fi
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
: > "$LOG"; T0=$(date +%s)
if [ -f "$STAGE/install" ] && [ -x "$BIN" ]; then install_staged; done_line "Updated" "switched to the staged build · $(since $T0)"; exit 0; fi

if [ -f "$DIR/jobs/run.sh" ]; then
  T=$(date +%s); (cd "$DIR" && bash jobs/run.sh) > "$DIR/jobs/out.txt" 2>&1 & JP=$!
  while kill -0 $JP 2>/dev/null; do live "Job" 50 "jobs/run.sh · $(since $T)"; K=$((K+1)); sleep 0.25; done
  wait $JP || true; mv -f "$DIR/jobs/run.sh" "$DIR/jobs/run.done"; done_line "Job" "$(tail -1 "$DIR/jobs/out.txt") · $(since $T)"
fi
done_line "Tools" "$(clang --version | head -1 | sed 's/ (.*//') · $(uname -m) · macOS $(sw_vers -productVersion)"

mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Flint</string>
  <key>CFBundleDisplayName</key><string>Flint</string>
  <key>CFBundleIdentifier</key><string>com.y.flint</string>
  <key>CFBundleExecutable</key><string>Flint</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>4</string>
  <key>CFBundleShortVersionString</key><string>0.4</string>
  <key>CFBundleIconFile</key><string>Flint</string>
  <key>LSMinimumSystemVersion</key><string>12.3</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSCameraUsageDescription</key><string>A website wants to use your camera.</string>
  <key>NSMicrophoneUsageDescription</key><string>A website wants to use your microphone.</string>
  <key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><true/><key>NSAllowsArbitraryLoadsInWebContent</key><true/></dict>
  <key>NSHumanReadableCopyright</key><string>MIT licence · WebKit</string>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>Web site URL</string>
    <key>CFBundleURLSchemes</key><array><string>http</string><string>https</string></array>
  </dict></array>
  <key>CFBundleDocumentTypes</key><array><dict>
    <key>CFBundleTypeName</key><string>HTML document</string>
    <key>CFBundleTypeRole</key><string>Viewer</string>
    <key>LSItemContentTypes</key><array><string>public.html</string></array>
  </dict></array>
</dict></plist>
PLIST
[ -f "$DIR/Flint.icns" ] && cp -f "$DIR/Flint.icns" "$APP/Contents/Resources/Flint.icns"
cp -f "$DIR/ext-shim.js" "$APP/Contents/Resources/ext-shim.js"
if [ -d "$DIR/pages" ]; then rm -rf "$APP/Contents/Resources/pages"; cp -R "$DIR/pages" "$APP/Contents/Resources/pages"; fi
# developer switches travel inside the app, so Flint never has to reach into Documents at launch
for f in jsc.env extdebug; do rm -f "$APP/Contents/Resources/$f"; if [ -f "$DIR/$f" ]; then cp -f "$DIR/$f" "$APP/Contents/Resources/$f"; fi; done
rm -rf "$APP/Contents/Frameworks" 2>/dev/null || true
done_line "Bundle" "Flint.app · extension layer"

if [ "$1" = "build" ] || [ ! -x "$BIN" ] || [ "$SRC" -nt "$BIN" ]; then
  T=$(date +%s)
  clang -fobjc-arc -O2 -Wall -Wno-deprecated-declarations -Wno-nonnull -Wno-unused-function -mmacosx-version-min=12.3 "$SRC" -o "$BIN" \
    -framework Cocoa -framework WebKit -framework UniformTypeIdentifiers -framework QuartzCore -framework Security -framework CoreServices -lsqlite3 >>"$LOG" 2>&1 & WP=$!
  while kill -0 $WP 2>/dev/null; do P=$(( 10 + ($(date +%s) - T) * 6 )); [ $P -gt 95 ] && P=95; live "Window" "$P" "compiling Flint.m · $(since $T)"; K=$((K+1)); sleep 0.25; done
  if ! wait $WP; then fail_line "Window" "build failed"; grep -m10 "error" "$LOG" | sed "s/^/   ${D}│${R} /"; exit 1; fi
  done_line "Window" "$(wc -l < "$SRC" | tr -d ' ') lines · $(grep -c warning: "$LOG" || true) warnings · $(since $T)"
else done_line "Window" "unchanged"; fi
# a stable local identity (if present) keeps macOS permissions across rebuilds; ad-hoc otherwise
SIGNID="Flint Local Signing"; SIGNED="ad-hoc"
if security find-certificate -c "$SIGNID" >/dev/null 2>&1 && codesign -s "$SIGNID" -f --identifier com.y.flint "$APP" >"$DIR/.sign.log" 2>&1; then SIGNED="$SIGNID"
else codesign -s - -f --identifier com.y.flint "$APP" >/dev/null 2>&1 || true; fi
echo "$SIGNED" > "$DIR/.signed-with"
rm -f "$STAGE/install"
if [ "$1" = "now" ] || [ $FIRST_STAGE = 1 ] || ! pgrep -a -x Flint >/dev/null; then
  install_staged; done_line "Launched" "total $(since $T0)"
else
  [ -s "$DIR/update-notes.txt" ] && cp -f "$DIR/update-notes.txt" "$STAGE/notes"
  date +%s > "$STAGE/ready"
  done_line "Staged" "Flint shows Update when you're ready · $(since $T0)"
fi
